{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "db:generate": "pnpm --filter @atlas/coordinator db:generate",
    "db:validate": "DATABASE_URL=postgresql://atlas:atlas_local_only@127.0.0.1:5433/atlas pnpm --filter @atlas/coordinator db:validate",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @atlas/coordinator test:integration",
    "typecheck": "turbo run typecheck",
    "validate": "pnpm format:check && pnpm db:generate && pnpm db:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
