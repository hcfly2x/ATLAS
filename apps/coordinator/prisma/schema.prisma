generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  FUTURE
  ARCHIVED
}

enum TaskState {
  NEW
  NORMALIZING
  ROUTING
  SPECIFYING
  WAITING_APPROVAL
  QUEUED
  RUNNING
  TESTING
  WAITING_RESULT_APPROVAL
  FINALIZING
  CANCEL_REQUESTED
  COMPLETED
  FAILED
  CANCELLED
}

enum TaskComplexity {
  SIMPLE
  MODERATE
  CRITICAL
}

enum ApprovalType {
  PRE_EXECUTION
  RESULT
  SENSITIVE_ACTION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ApprovalActor {
  USER
  SYSTEM
}

enum ApprovalChannel {
  TELEGRAM
  POLICY
}

enum ApprovalTargetType {
  SPECIFICATION
  EXECUTION_RESULT
  SENSITIVE_ACTION
}

enum ExecutionStatus {
  QUEUED
  RUNNING
  TESTING
  AWAITING_RESULT_APPROVAL
  FINALIZING
  SUCCEEDED
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum WorkerStatus {
  OFFLINE
  IDLE
  BUSY
  DISABLED
}

enum AuditActor {
  USER
  AGENT
  WORKER
  SYSTEM
}

enum MemoryType {
  DECISION
  SUMMARY
  NOTE
}

model Project {
  id                    String            @id
  name                  String
  risk                  String
  dataClassification    String            @map("data_classification")
  policy                String
  autonomyLevel         Int               @default(2) @map("autonomy_level")
  repository            String?
  protectedPathsProfile String            @map("protected_paths_profile")
  allowedCommands       Json              @map("allowed_commands")
  requiredTools         Json              @map("required_tools")
  taskCostLimitUsd      Decimal?          @map("task_cost_limit_usd") @db.Decimal(10, 2)
  retention             Json
  status                ProjectStatus     @default(DRAFT)
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  tasks                 Task[]
  auditEvents           AuditEvent[]
  telegramSessions      TelegramSession[]
  llmCalls              LlmCall[]
  codexUsages           CodexUsage[]
  memoryItems           MemoryItem[]
  telegramDeliveries    TelegramTaskDelivery[]

  @@map("projects")
}

model Task {
  id                    String          @id @default(uuid())
  projectId             String          @map("project_id")
  origin                String
  originalMessage       String          @map("original_message")
  normalizedDemand      Json?           @map("normalized_demand")
  complexity            TaskComplexity?
  state                 TaskState       @default(NEW)
  failureStage          String?         @map("failure_stage")
  version               Int             @default(0)
  idempotencyKey        String          @unique @map("idempotency_key")
  activeSpecificationId String?         @unique @map("active_specification_id")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  project               Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  activeSpecification   Specification?  @relation("ActiveSpecification", fields: [activeSpecificationId], references: [id], onDelete: Restrict)
  specifications        Specification[] @relation("TaskSpecifications")
  approvals             Approval[]
  executions            Execution[]
  auditEvents           AuditEvent[]
  llmCalls              LlmCall[]
  codexUsages           CodexUsage[]
  memoryItems           MemoryItem[]
  telegramDelivery      TelegramTaskDelivery?

  @@index([projectId, state])
  @@map("tasks")
}

model Specification {
  id            String      @id @default(uuid())
  taskId        String      @map("task_id")
  version       Int
  payload       Json
  payloadHash   String      @map("payload_hash")
  createdAt     DateTime    @default(now()) @map("created_at")
  task          Task        @relation("TaskSpecifications", fields: [taskId], references: [id], onDelete: Restrict)
  activeForTask Task?       @relation("ActiveSpecification")
  executions    Execution[]

  @@unique([taskId, version])
  @@unique([taskId, payloadHash])
  @@map("specifications")
}

model Approval {
  id               String             @id @default(uuid())
  taskId           String             @map("task_id")
  type             ApprovalType
  status           ApprovalStatus     @default(PENDING)
  actor            ApprovalActor      @default(USER)
  targetType       ApprovalTargetType @map("target_type")
  targetId         String             @map("target_id")
  targetVersion    Int?               @map("target_version")
  targetHash       String             @map("target_hash")
  presentedPayload Json               @map("presented_payload")
  requestedBy      String             @map("requested_by")
  decidedBy        String?            @map("decided_by")
  requestedAt      DateTime           @default(now()) @map("requested_at")
  respondedAt      DateTime?          @map("responded_at")
  expiresAt        DateTime?          @map("expires_at")
  channel          ApprovalChannel
  idempotencyKey   String             @unique @map("idempotency_key")
  task             Task               @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([taskId, status])
  @@index([targetType, targetId])
  @@map("approvals")
}

model LlmCall {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  taskId           String   @map("task_id")
  agentId          String   @map("agent_id")
  model            String
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  estimatedCostUsd Decimal  @map("estimated_cost_usd") @db.Decimal(12, 8)
  latencyMs        Int      @map("latency_ms")
  correlationId    String   @map("correlation_id")
  createdAt        DateTime @default(now()) @map("created_at")
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@map("llm_calls")
}

model Execution {
  id                   String          @id @default(uuid())
  taskId               String          @map("task_id")
  specificationId      String          @map("specification_id")
  workerId             String?         @map("worker_id")
  attempt              Int
  status               ExecutionStatus @default(QUEUED)
  branch               String?
  worktree             String?
  commands             Json?
  exitCodes            Json?           @map("exit_codes")
  logsRef              String?         @map("logs_ref")
  diffSummary          Json?           @map("diff_summary")
  diffHash             String?         @map("diff_hash")
  testResult           Json?           @map("test_result")
  failureStage         String?         @map("failure_stage")
  idempotencyKey       String          @unique @map("idempotency_key")
  leaseId              String?         @unique @map("lease_id")
  leaseExpiresAt       DateTime?       @map("lease_expires_at")
  fencingToken         BigInt          @default(0) @map("fencing_token")
  claimIdempotencyKey  String?         @unique @map("claim_idempotency_key")
  resultIdempotencyKey String?         @unique @map("result_idempotency_key")
  resultHash           String?         @map("result_hash")
  resultPayload        Json?           @map("result_payload")
  resultSequence       Int?            @map("result_sequence")
  finalizationIdempotencyKey String?   @unique @map("finalization_idempotency_key")
  finalizationHash     String?         @map("finalization_hash")
  reconciledAt         DateTime?       @map("reconciled_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  task                 Task            @relation(fields: [taskId], references: [id], onDelete: Restrict)
  specification        Specification   @relation(fields: [specificationId], references: [id], onDelete: Restrict)
  worker               Worker?         @relation(fields: [workerId], references: [id], onDelete: Restrict)
  logChunks            WorkerLogChunk[]
  codexUsage           CodexUsage?

  @@unique([taskId, attempt])
  @@index([status, leaseExpiresAt])
  @@map("executions")
}

model Worker {
  id               String       @id @default(uuid())
  name             String
  tokenHash        String       @unique @map("token_hash")
  projectScopes    Json         @map("project_scopes")
  capabilities     Json
  concurrencyLimit Int          @default(1) @map("concurrency_limit")
  lastHeartbeatAt  DateTime?    @map("last_heartbeat_at")
  status           WorkerStatus @default(OFFLINE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  executions       Execution[]

  @@map("workers")
}

model WorkerLogChunk {
  id             String    @id @default(uuid())
  executionId    String    @map("execution_id")
  sequence       Int
  checksum       String
  sizeBytes      Int       @map("size_bytes")
  content        String
  payloadHash    String    @map("payload_hash")
  idempotencyKey String    @unique @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  execution      Execution @relation(fields: [executionId], references: [id], onDelete: Restrict)

  @@unique([executionId, sequence])
  @@index([executionId, createdAt])
  @@map("worker_log_chunks")
}

model CodexUsage {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  taskId           String    @map("task_id")
  executionId      String    @unique @map("execution_id")
  estimatedCostUsd Decimal   @map("estimated_cost_usd") @db.Decimal(12, 8)
  startedAt        DateTime  @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task             Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  execution        Execution @relation(fields: [executionId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@map("codex_usages")
}

model AuditEvent {
  id             String     @id @default(uuid())
  projectId      String     @map("project_id")
  taskId         String?    @map("task_id")
  targetType     String?    @map("target_type")
  targetId       String?    @map("target_id")
  correlationId  String     @map("correlation_id")
  actor          AuditActor
  action         String
  payload        Json
  idempotencyKey String     @unique @map("idempotency_key")
  createdAt      DateTime   @default(now()) @map("created_at")
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task           Task?      @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@map("audit_events")
}

model MemoryItem {
  id             String     @id @default(uuid())
  projectId      String     @map("project_id")
  type           MemoryType
  content        String
  taskId         String?    @map("task_id")
  agentId        String?    @map("agent_id")
  idempotencyKey String     @unique @map("idempotency_key")
  payloadHash    String     @map("payload_hash")
  createdAt      DateTime   @default(now()) @map("created_at")
  project        Project    @relation(fields: [projectId], references: [id], onDelete: Restrict)
  task           Task?      @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([projectId, type, createdAt])
  @@index([taskId, createdAt])
  @@map("memory_items")
}

model TelegramSession {
  userId            BigInt   @id @map("user_id")
  chatId            BigInt   @map("chat_id")
  selectedProjectId String?  @map("selected_project_id")
  verboseLevel      Int      @default(0) @map("verbose_level")
  updatedAt         DateTime @updatedAt @map("updated_at")
  selectedProject   Project? @relation(fields: [selectedProjectId], references: [id], onDelete: Restrict)

  @@index([selectedProjectId])
  @@map("telegram_sessions")
}

model TelegramTaskDelivery {
  taskId            String    @id @map("task_id")
  projectId         String    @map("project_id")
  userId            BigInt    @map("user_id")
  chatId            BigInt    @map("chat_id")
  lastTaskVersion   Int       @default(-1) @map("last_task_version")
  lastLogSequence   Int       @default(-1) @map("last_log_sequence")
  lastLogOffset     Int       @default(0) @map("last_log_offset")
  lastActivityAt    DateTime? @map("last_activity_at")
  finalDeliveredAt  DateTime? @map("final_delivered_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  task              Task      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId, updatedAt])
  @@map("telegram_task_deliveries")
}

model TelegramUpdate {
  updateId    BigInt   @id @map("update_id")
  callbackId  String?  @unique @map("callback_id")
  userId      BigInt   @map("user_id")
  chatId      BigInt   @map("chat_id")
  response    Json
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("telegram_updates")
}
