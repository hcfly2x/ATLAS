{
  "name": "@atlas/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @atlas/contracts build && tsc -b && vite build",
    "check:dependencies": "node --experimental-strip-types scripts/check-dependencies.ts",
    "dev": "vite",
    "doctor": "react-doctor . --no-telemetry --yes",
    "lint": "eslint . --max-warnings 0 && pnpm check:dependencies && pnpm doctor",
    "preview": "vite preview",
    "test": "pnpm build && vitest run && pnpm test:e2e",
    "test:e2e": "playwright install chromium && playwright test",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@atlas/contracts": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "axe-core": "4.12.1",
    "jsdom": "29.0.1",
    "react-doctor": "0.9.2",
    "shadcn": "4.16.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
